font-family = "CaskaydiaCove Nerd Font"
font-size = 11
window-padding-y = 0
window-padding-x = 0
theme = light:Ayu Light,dark:Aura
window-decoration = false
macos-titlebar-style = hidden
window-padding-color = background
shell-integration = detect
# OpenCode notifier uses Ghostty's native notification protocol; no generated
# notifier state is stored in this file.
