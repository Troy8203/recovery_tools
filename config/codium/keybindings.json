[
  {
    "key": "ctrl+shift+k",
    "command": "workbench.action.toggleMaximizedPanel",
    "when": "panelAlignment == 'center' || panelPosition != 'bottom' && panelPosition != 'top'"
  },
  {
    "key": "ctrl+shift+alt+c",
    "command": "copyRelativeFilePath",
    "when": "editorFocus"
  },
  {
    "key": "ctrl+k ctrl+shift+alt+c",
    "command": "-copyRelativeFilePath",
    "when": "editorFocus"
  }
]
